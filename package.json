{
  "name": "civitai-model-manager",
  "version": "1.3.0",
  "description": "The missing model manager for ComfyUI with verified CivitAI API integration and intelligent auto-sorting.",
  "main": "dist/main/index.js",
  "bin": {
    "cmm": "bin/cmm.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --base ./ && tsc -p tsconfig.main.json",
    "preview": "vite preview",
    "test": "vitest run",
    "cmm": "node bin/cmm.js",
    "version:bump": "node scripts/update-version.js",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:preview": "npm run build && electron . --preview",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:installer": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:all": "npm run build && electron-builder -wl",
    "cmm:start": "powershell -ExecutionPolicy Bypass -File ./cmm.ps1 start",
    "cmm:stop": "powershell -ExecutionPolicy Bypass -File ./cmm.ps1 stop",
    "cmm:restart": "powershell -ExecutionPolicy Bypass -File ./cmm.ps1 restart",
    "cmm:status": "powershell -ExecutionPolicy Bypass -File ./cmm.ps1 status",
    "cmm:package": "powershell -ExecutionPolicy Bypass -File ./cmm.ps1 package",
    "cmm:start:linux": "./cmm.sh start",
    "cmm:stop:linux": "./cmm.sh stop",
    "cmm:restart:linux": "./cmm.sh restart",
    "cmm:status:linux": "./cmm.sh status",
    "cmm:package:linux": "./cmm.sh package",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "civitai",
    "comfyui",
    "model-manager",
    "stable-diffusion",
    "flux",
    "lora",
    "checkpoint"
  ],
  "author": {
    "name": "DevNullInc (/dev/null Inc / TheStygianRenegade)",
    "email": "devnull@devnullinc.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DevNullInc/Civitai-manager-ComfyUI.git"
  },
  "bugs": {
    "url": "https://github.com/DevNullInc/Civitai-manager-ComfyUI/issues"
  },
  "homepage": "https://github.com/DevNullInc/Civitai-manager-ComfyUI#readme",
  "license": "GPL-3.0",
  "dependencies": {
    "adm-zip": "^0.6.0",
    "axios": "^1.7.9",
    "chokidar": "^4.0.3",
    "electron-log": "^5.3.0",
    "electron-updater": "^6.8.9",
    "keytar": "^7.9.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^1.8.11",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.6"
  },
  "overrides": {
    "@tootallnate/once": "^2.0.1"
  },
  "build": {
    "appId": "com.devnullinc.civitai-manager-comfyui",
    "productName": "CivitAI Model Manager",
    "copyright": "Copyright (C) 2025-2026 TheStygianRenegade / /dev/null Inc",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-Standalone-v${version}.exe"
    },
    "linux": {
      "maintainer": "TheStygianRenegade / /dev/null Inc <devnull@devnullinc.com>",
      "target": [
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics"
    }
  },
  "allowScripts": {
    "electron@44.0.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "keytar@7.9.0": true,
    "sqlite3@6.0.1": true
  }
}
