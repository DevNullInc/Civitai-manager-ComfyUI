{
  "name": "civitai-model-manager",
  "version": "1.0.0",
  "description": "The missing model manager for ComfyUI with verified CivitAI API integration and intelligent auto-sorting.",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.main.json",
    "preview": "vite preview",
    "test": "vitest run",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:preview": "npm run build && electron . --preview",
    "cmm:start": "powershell -ExecutionPolicy Bypass -File ./cmm.ps1 start",
    "cmm:stop": "powershell -ExecutionPolicy Bypass -File ./cmm.ps1 stop",
    "cmm:restart": "powershell -ExecutionPolicy Bypass -File ./cmm.ps1 restart",
    "cmm:status": "powershell -ExecutionPolicy Bypass -File ./cmm.ps1 status",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "civitai",
    "comfyui",
    "model-manager",
    "stable-diffusion",
    "flux",
    "lora",
    "checkpoint"
  ],
  "author": "",
  "license": "GPL-3.0",
  "dependencies": {
    "axios": "^1.7.9",
    "chokidar": "^4.0.3",
    "electron-log": "^5.3.0",
    "electron-updater": "^6.3.9",
    "keytar": "^7.9.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^1.8.11",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.6"
  },
  "build": {
    "appId": "com.yourusername.civitai-model-manager",
    "productName": "CivitAI Model Manager",
    "copyright": "Copyright © 2025",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics"
    }
  }
}